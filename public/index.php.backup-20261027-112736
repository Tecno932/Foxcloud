<?php
declare(strict_types=1);

session_start();

header('X-Content-Type-Options: nosniff');
header('Referrer-Policy: strict-origin-when-cross-origin');
header('X-Frame-Options: DENY');

function e(string $value): string
{
    return htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

$pages = [
    'home' => ['Inicio', 'Descubre contenido para Minecraft.'],
    'mods' => ['Mods', 'Explora mods y complementos.'],
    'skins' => ['Skins', 'Encuentra tu próxima skin.'],
    'holographic' => ['Holographic', 'Modelos y texturas holográficas.'],
    'maps' => ['Mapas', 'Descubre nuevos mundos.'],
    'textures' => ['Texturas', 'Personaliza tu Minecraft.'],
    'shaders' => ['Shaders', 'Mejora el apartado visual.'],
    'login' => ['Iniciar sesión', 'Accede a tu cuenta FoxCraft.'],
    'register' => ['Crear cuenta', 'Únete a la comunidad FoxCraft.'],
    'profile' => ['Perfil', 'Tu espacio personal en FoxCraft.'],
];

$page = (string) ($_GET['page'] ?? 'home');

if (!isset($pages[$page])) {
    http_response_code(404);
    $page = 'home';
}

[$title, $description] = $pages[$page];

$categories = [
    'mods' => 'Mods',
    'skins' => 'Skins',
    'holographic' => 'Holographic',
    'maps' => 'Mapas',
    'textures' => 'Texturas',
    'shaders' => 'Shaders',
];

if (!isset($_SESSION['csrf_token'])) {
    $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
}

$errors = [];
$username = '';
$email = '';
$successMessage = (string) ($_SESSION['flash'] ?? '');
unset($_SESSION['flash']);

if ($_SERVER['REQUEST_METHOD'] === 'POST' && $page === 'register') {
    $username = trim((string) ($_POST['username'] ?? ''));
    $email = strtolower(trim((string) ($_POST['email'] ?? '')));
    $password = (string) ($_POST['password'] ?? '');
    $csrfToken = (string) ($_POST['csrf_token'] ?? '');

    if (!hash_equals($_SESSION['csrf_token'], $csrfToken)) {
        $errors[] = 'El formulario venció o no es válido. Recargá la página e intentá nuevamente.';
    }

    if (!preg_match('/\A[a-zA-Z0-9_]{3,32}\z/', $username)) {
        $errors[] = 'El usuario debe tener entre 3 y 32 caracteres: letras, números o guion bajo.';
    }

    if (!filter_var($email, FILTER_VALIDATE_EMAIL) || strlen($email) > 254) {
        $errors[] = 'Ingresá un correo electrónico válido.';
    }

    if (strlen($password) < 12 || strlen($password) > 4096) {
        $errors[] = 'La contraseña debe tener al menos 12 caracteres.';
    }

    if (!$errors) {
        try {
            require_once '/var/www/foxcraft/app/Core/Database.php';

            $pdo = \FoxCraft\Core\Database::connection();

            $check = $pdo->prepare(
                'SELECT id FROM users WHERE username = :username OR email = :email LIMIT 1'
            );
            $check->execute([
                'username' => $username,
                'email' => $email,
            ]);

            if ($check->fetch()) {
                $errors[] = 'Ese nombre de usuario o correo ya está registrado.';
            } else {
                $pdo->beginTransaction();

                $insert = $pdo->prepare(
                    'INSERT INTO users (username, email, password_hash, role, status)
                     VALUES (:username, :email, :password_hash, :role, :status)'
                );

                $insert->execute([
                    'username' => $username,
                    'email' => $email,
                    'password_hash' => password_hash($password, PASSWORD_DEFAULT),
                    'role' => 'user',
                    'status' => 'active',
                ]);

                $userId = (int) $pdo->lastInsertId();

                $profile = $pdo->prepare(
                    'INSERT INTO profiles (user_id, display_name)
                     VALUES (:user_id, :display_name)'
                );

                $profile->execute([
                    'user_id' => $userId,
                    'display_name' => $username,
                ]);

                $pdo->commit();

                session_regenerate_id(true);
                $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
                $_SESSION['flash'] = '¡Cuenta creada correctamente! Ahora podés iniciar sesión.';

                header('Location: /?page=login', true, 303);
                exit;
            }
        } catch (\PDOException $exception) {
            if (isset($pdo) && $pdo instanceof \PDO && $pdo->inTransaction()) {
                $pdo->rollBack();
            }

            if ($exception->getCode() === '23000') {
                $errors[] = 'Ese nombre de usuario o correo ya está registrado.';
            } else {
                error_log('FoxCraft registration database error: ' . $exception->getMessage());
                $errors[] = 'No pudimos crear tu cuenta en este momento. Intentá nuevamente.';
            }
        } catch (\Throwable $exception) {
            if (isset($pdo) && $pdo instanceof \PDO && $pdo->inTransaction()) {
                $pdo->rollBack();
            }

            error_log('FoxCraft registration error: ' . $exception->getMessage());
            $errors[] = 'Ocurrió un error inesperado. Intentá nuevamente.';
        }
    }
}
?>
