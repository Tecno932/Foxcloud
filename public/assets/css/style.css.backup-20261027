:root {
    color-scheme: dark;
    --bg: #0c0e0d;
    --surface: #141815;
    --surface-2: #1b211c;
    --border: #29332b;
    --text: #f2f4ef;
    --muted: #a2aca2;
    --green: #b6f36a;
    --green-dark: #7fb73e;
    --radius: 18px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
}

* { box-sizing: border-box; }

body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
}

a { color: inherit; text-decoration: none; }
button, input { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }

.site-header {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 78px;
    padding: 16px clamp(20px, 5vw, 76px);
    border-bottom: 1px solid #ffffff0d;
    background: #0c0e0df2;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: 1.4px;
}

.brand-mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 11px;
    background: var(--green);
    color: #10150c;
    font-size: 22px;
    font-weight: 950;
}

.accent { color: var(--green); }

.main-nav, .header-actions, .hero-actions {
    display: flex;
    align-items: center;
    gap: 18px;
}

.main-nav a {
    color: var(--muted);
    font-size: 13px;
    font-weight: 650;
    transition: color .2s ease;
}

.main-nav a:hover, .main-nav a[aria-current="page"] { color: var(--green); }

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    transition: transform .2s ease, background .2s ease;
}

.button:hover { transform: translateY(-2px); }
.button-primary { background: var(--green); color: #11170c; }
.button-primary:hover { background: #c9ff8a; }
.button-quiet { color: var(--text); }
.button-outline { border-color: #56624f; color: var(--text); }
.button-full { width: 100%; margin-top: 12px; }
button:disabled, input:disabled { opacity: .55; cursor: not-allowed; }

.menu-toggle {
    display: none;
    padding: 7px 10px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text);
}

.hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: center;
    min-height: 490px;
    overflow: hidden;
    padding: 72px clamp(24px, 9vw, 140px);
    border-bottom: 1px solid #ffffff0d;
    background:
        radial-gradient(ellipse at 75% 48%, #47692a30, transparent 42%),
        linear-gradient(120deg, #111512, #0c0e0d 70%);
}

.hero-content { position: relative; z-index: 1; max-width: 650px; }

.eyebrow {
    display: inline-block;
    color: var(--green);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2.2px;
}

h1, h2, p { margin-top: 0; }
.hero h1 {
    margin: 18px 0;
    font-size: clamp(44px, 6.5vw, 78px);
    line-height: 1.04;
    letter-spacing: -4px;
}

.hero-content > p, .section-heading > p, .community p,
.category-hero > p, .empty-state > p {
    max-width: 560px;
    color: var(--muted);
    font-size: 16px;
}

.hero-actions { flex-wrap: wrap; margin-top: 28px; gap: 12px; }

.hero-art {
    position: relative;
    display: grid;
    min-height: 300px;
    place-items: center;
}

.art-glow {
    position: absolute;
    width: 270px;
    height: 270px;
    border-radius: 50%;
    background: #a8f15b18;
    filter: blur(30px);
}

.art-cube {
    display: grid;
    width: 190px;
    height: 190px;
    place-items: center;
    transform: rotate(-8deg);
    border: 1px solid #c5ff8c80;
    border-radius: 38px;
    background: linear-gradient(140deg, #b6f36a, #446d27);
    box-shadow: 0 25px 100px #a4f35a20, inset 0 0 0 12px #ffffff0b;
    color: #17210f;
    font-size: 100px;
    font-weight: 950;
}

.art-tag {
    position: absolute;
    padding: 7px 12px;
    border: 1px solid #ffffff24;
    border-radius: 9px;
    background: #171d18eF;
    color: var(--green);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
}

.tag-one { top: 18%; left: 8%; }
.tag-two { top: 28%; right: 2%; }
.tag-three { bottom: 14%; left: 20%; }

.section { padding: 64px clamp(24px, 7vw, 100px); }

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
}

.section-heading h2, .community h2 {
    margin: 8px 0 0;
    font-size: clamp(25px, 3vw, 36px);
    letter-spacing: -1px;
}

.section-heading > p { max-width: 320px; margin-bottom: 4px; font-size: 13px; }

.category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
}

.category-card {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 104px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(140deg, var(--surface-2), var(--surface));
    transition: border-color .2s ease, transform .2s ease;
}

.category-card:hover { transform: translateY(-3px); border-color: var(--green-dark); }
.category-icon { color: var(--green); font-size: 28px; }
.category-name { font-weight: 800; }
.category-arrow { margin-left: auto; color: var(--muted); }

.community {
    margin: 0 clamp(24px, 7vw, 100px) 70px;
    padding: 42px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: radial-gradient(ellipse at 90% 20%, #a5ed5018, transparent 45%), var(--surface);
}

.community h2 { margin-bottom: 10px; }
.community p { font-size: 14px; }
.community .button { margin-top: 8px; }

.category-hero, .empty-state {
    max-width: 900px;
    min-height: 400px;
    margin: 0 auto;
    padding: 100px 24px;
}

.category-hero h1, .empty-state h1, .auth-card h1 {
    margin: 12px 0;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -2px;
}

.notice {
    margin: 24px 0;
    padding: 16px;
    border: 1px solid #b6f36a30;
    border-radius: 12px;
    background: #b6f36a0a;
    color: #d2dfc9;
    font-size: 13px;
}

.auth-section {
    display: grid;
    min-height: 650px;
    place-items: center;
    padding: 55px 20px;
    background: radial-gradient(ellipse at 50% 20%, #42632720, transparent 55%);
}

.auth-card {
    width: min(100%, 440px);
    padding: 34px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
}

.auth-card > p { color: var(--muted); font-size: 14px; }
.auth-card form { display: grid; gap: 9px; margin-top: 22px; }
.auth-card label { margin-top: 8px; font-size: 12px; font-weight: 750; }

.auth-card input {
    width: 100%;
    min-height: 46px;
    padding: 12px;
    border: 1px solid #354036;
    border-radius: 9px;
    outline: none;
    background: #0c100d;
    color: var(--text);
}

.auth-card input:focus { border-color: var(--green-dark); }
.auth-switch { margin-top: 24px; text-align: center; font-size: 13px !important; }
.auth-switch a { color: var(--green); font-weight: 800; }

.site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 26px clamp(24px, 5vw, 76px);
    border-top: 1px solid #ffffff12;
    color: var(--muted);
    font-size: 12px;
}

.site-footer p { margin: 0; }

@media (max-width: 1050px) {
    .site-header { flex-wrap: wrap; }
    .menu-toggle { display: block; margin-left: auto; }
    .main-nav { display: none; order: 3; width: 100%; flex-wrap: wrap; padding: 12px 0; }
    .main-nav.is-open { display: flex; }
    .header-actions { gap: 8px; }
    .hero { padding-inline: 6vw; }
}

@media (max-width: 700px) {
    .site-header { gap: 12px; padding: 14px 18px; }
    .brand { font-size: 15px; }
    .header-actions { width: 100%; }
    .header-actions .button { flex: 1; }
    .main-nav { gap: 14px; }
    .hero { grid-template-columns: 1fr; padding: 60px 24px 25px; }
    .hero h1 { letter-spacing: -2px; }
    .hero-art { min-height: 250px; }
    .art-cube { width: 150px; height: 150px; font-size: 78px; }
    .section { padding: 44px 22px; }
    .section-heading { align-items: start; flex-direction: column; }
    .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .category-card { min-height: 90px; gap: 10px; padding: 14px; }
    .category-name { font-size: 13px; }
    .category-icon { font-size: 22px; }
    .community { margin: 0 18px 40px; padding: 28px 22px; }
    .auth-card { padding: 25px 20px; }
    .site-footer { align-items: flex-start; flex-direction: column; }
}

@media (max-width: 390px) {
    .category-grid { grid-template-columns: 1fr; }
}
